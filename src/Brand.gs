/**
 * USBOXLA branding: the brand blue and the "Officially Sanctioned Event" shield,
 * used on the parent page, in emails and on every sheet.
 */

const BRAND_BLUE = '#005EC4';
// 230x240 PNG of the USBOXLA shield (transparent background).
const USBOXLA_LOGO_B64 = '';

function usboxlaLogoBlob_() {
  return Utilities.newBlob(Utilities.base64Decode(USBOXLA_LOGO_B64), 'image/png', 'usboxla.png');
}

function usboxlaLogoDataUri_() {
  return 'data:image/png;base64,' + USBOXLA_LOGO_B64;
}

/** Puts the USBOXLA shield at the top of a "How this works" tab. */
function addLogoToHelp_(help) {
  help.insertRowBefore(1);
  help.setRowHeight(1, 110);
  help.insertImage(usboxlaLogoBlob_(), 1, 1, 8, 6).setHeight(100).setWidth(96);
}

/** Run once: recolours the header row of the Hub and every event's sheets in USBOXLA blue. */
function applyBranding() {
  const paint = function (sh) {
    if (!sh || sh.getLastColumn() < 1) return;
    sh.getRange(1, 1, 1, sh.getLastColumn()).setBackground(BRAND_BLUE).setFontColor('#ffffff').setFontWeight('bold');
  };
  const hub = hub_();
  paint(hub.getSheetByName('Events'));
  paint(hub.getSheetByName(POOL_SHEET));
  const ids = [];
  readAll_('EventData').forEach(function (d) { ids.push(d.DirectorSheetID); });
  readAll_('TeamData').forEach(function (t) { ids.push(t.RosterSheetID); });
  ids.filter(Boolean).forEach(function (id) {
    try { paint(SpreadsheetApp.openById(id).getSheets()[0]); } catch (err) { console.error(err); }
  });
  console.log('Branded the Hub and ' + ids.filter(Boolean).length + ' event sheets.');
}
